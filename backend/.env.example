# ==============================================================================
# AETHER Mining Intelligence Platform - Backend Environment Variables
# ==============================================================================

# Core Application Settings
APP_NAME=MOIL Mining Intelligence Platform API
APP_VERSION=3.4.0
API_PREFIX=/api
DEBUG=False
ENVIRONMENT=production

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# CORS Allowed Origins (Comma-separated URLs, e.g. Vercel frontend URL)
CORS_ORIGINS=https://your-aether-frontend.vercel.app,http://localhost:5173

# Database Configuration (PostgreSQL / Supabase URL)
# If empty, automatically falls back to local SQLite database
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_PATH=backend/database/feedback.db

# Machine Learning Assets Directory
MODELS_DIR=models

# Google Earth Engine (Optional / Cloud Integration)
GEE_PROJECT_ID=your-gcp-project-id
GEE_SERVICE_ACCOUNT=your-gee-sa@your-gcp-project.iam.gserviceaccount.com
