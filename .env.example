# ==============================================================================
# AETHER MINING INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or configure in Vercel / Render Environment Variables
# ==============================================================================

# --- APPLICATION & ENVIRONMENT ---
ENVIRONMENT=production
DEBUG=false
PORT=8000
SECRET_KEY=generate_a_secure_random_key_for_production

# --- CORS & CLIENT URLS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://aether-mining.vercel.app,http://localhost:5173,http://localhost:3000

# --- FRONTEND (Vite) ---
# Set this in Vercel environment variables pointing to your deployed Render backend
VITE_API_BASE_URL=https://aether-backend.onrender.com/api

# --- DATABASE (PostgreSQL / Supabase) ---
# Leave empty to use local resilient SQLite fallback
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- GOOGLE EARTH ENGINE (Optional Satellite EO Integration) ---
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=
